M5 (Apple T8142) FreeBSD: platform DRM devices. drm-kmod reports "platform:<name>" in
hw.dri.N.busid for devices without a PCI address (Apple DCP display, AGX GPU); parse
it as DRM_BUS_PLATFORM instead of looking the device up on /dev/pci.

--- xf86drm.c.orig
+++ xf86drm.c
@@ -3616,6 +3616,10 @@
 
     return -EINVAL;
 }
+#endif
+
+#ifdef __FreeBSD__
+static int get_sysctl_busid(int maj, int min, char *busid, size_t len);
 #endif
 
 static int drmParseSubsystemType(int maj, int min)
@@ -3639,8 +3643,16 @@
             return DRM_BUS_VIRTIO;
      }
     return subsystem_type;
-#elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__)
+#elif defined(__FreeBSD__)
+    char busid[256];
+
+    /* drm-kmod reports "platform:<name>" for devices without a PCI address */
+    if (get_sysctl_busid(maj, min, busid, sizeof(busid)) == 0 &&
+        strncmp(busid, "platform:", 9) == 0)
+        return DRM_BUS_PLATFORM;
     return DRM_BUS_PCI;
+#elif defined(__OpenBSD__) || defined(__DragonFly__)
+    return DRM_BUS_PCI;
 #else
 #warning "Missing implementation of drmParseSubsystemType"
     return -EINVAL;
